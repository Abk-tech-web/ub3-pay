# ── Firebase ─────────────────────────────────────────────
# Must be prefixed EXPO_PUBLIC_ — Expo only exposes prefixed vars to the
# client bundle. These values aren't secret (every Firebase web config
# ships inside the app bundle by design) — real protection is Firestore
# Security Rules (see docs/firestore.rules), not hiding this config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Transactional email (never use Firebase's default sender) ──
EMAIL_PROVIDER=sendgrid          # sendgrid | postmark | ses
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@ub3pay.app
EMAIL_FROM_NAME="Ub3 Pay"

# ── KYC provider (licensed vendor — see docs/TODO_INTEGRATIONS.md) ──
KYC_PROVIDER=smile_id             # smile_id | verifyme | prembly
KYC_API_KEY=
KYC_PARTNER_ID=

# ── Banking-as-a-Service / virtual account provider ──
BAAS_PROVIDER=paystack             # paystack | flutterwave | monnify
BAAS_SECRET_KEY=
BAAS_PUBLIC_KEY=
BAAS_WEBHOOK_SECRET=

# ── Rate / price data ──
# Live now with NO key required: CoinGecko public API (prices) and
# open.er-api.com (USD→NGN). Add a CoinGecko key only if you outgrow
# the free tier's rate limits.
COINGECKO_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Blockchain node / infra providers ──
EVM_RPC_URL_ETHEREUM=
EVM_RPC_URL_POLYGON=
EVM_RPC_URL_BSC=
EVM_RPC_URL_ARBITRUM=
EVM_RPC_URL_OPTIMISM=
EVM_RPC_URL_BASE=
EVM_RPC_URL_AVALANCHE=
SOLANA_RPC_URL=
TRON_API_KEY=
TON_API_KEY=
SUI_RPC_URL=
CARDANO_API_KEY=
BITCOIN_NODE_URL=
XRP_RPC_URL=

# ── Key management (recommended: MPC/HSM provider, not raw seeds) ──
WALLET_INFRA_PROVIDER=            # e.g. fireblocks | coinbase-mpc
WALLET_INFRA_API_KEY=

# ── VTU (future phase — Airtime/Data) ──
VTU_PROVIDER=                      # vtpass | clubkonnect
VTU_API_KEY=

# ── App ──
APP_ENV=development
SENTRY_DSN=
