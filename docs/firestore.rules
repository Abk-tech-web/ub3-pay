rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read/create their own profile doc, but can only
    // update non-sensitive fields themselves — kycStatus must NOT be
    // client-writable in production (see note below).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      // TODO(security): once a backend (Render + Cloud Functions) exists,
      // restrict kycStatus updates to server-side writes only — e.g.:
      //   allow update: if request.auth.uid == uid
      //     && !("kycStatus" in request.resource.data.diff(resource.data).affectedKeys());
      // Right now the client can set its own kycStatus, which is fine for
      // a mock KYC flow but must change before this handles real money.
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
