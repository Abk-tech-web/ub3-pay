{
  "expo": {
    "name": "Ub3 Pay",
    "slug": "ub3-pay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0A0A0C",
      "resizeMode": "contain"
    },
    "android": {
      "package": "app.ub3pay.wallet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
